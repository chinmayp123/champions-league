{
  "name": "futbol-lab",
  "version": "1.2.0",
  "description": "Futbol Lab \u2014 football match tracker + prediction model (the website, and a desktop app around it)",
  "type": "module",
  "bin": {
    "futbol-lab": "./cli.mjs"
  },
  "scripts": {
    "start": "node cli.mjs",
    "widget": "electron widget/main.cjs",
    "dist": "electron-builder --win"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^42.4.0",
    "electron-builder": "^26.15.3",
    "playwright-core": "^1.61.1"
  },
  "main": "widget/main.cjs",
  "build": {
    "appId": "lab.futbol.widget",
    "productName": "Futbol Lab",
    "artifactName": "Futbol-Lab-Setup.${ext}",
    "directories": {
      "output": "dist"
    },
    "asar": true,
    "files": [
      "widget/main.cjs",
      "widget/icon.ico",
      "widget/icon.png",
      "widget/tray.png",
      "widget/tray@2x.png",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "widget/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Futbol Lab"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "widget/icon.png",
      "category": "public.app-category.sports"
    },
    "dmg": {
      "artifactName": "Futbol-Lab-${arch}.${ext}"
    }
  }
}
