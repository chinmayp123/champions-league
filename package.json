{
  "name": "starball-lab",
  "version": "1.1.0",
  "description": "Starball Lab \u2014 Champions League match tracker + betting harness (desktop widget)",
  "type": "module",
  "bin": {
    "champions-league": "./cli.mjs"
  },
  "scripts": {
    "start": "node cli.mjs",
    "widget": "electron widget/main.cjs",
    "dist": "electron-builder --win"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^42.4.0",
    "electron-builder": "^26.15.3",
    "playwright-core": "^1.61.1"
  },
  "main": "widget/main.cjs",
  "build": {
    "appId": "lab.starball.widget",
    "productName": "Starball Lab",
    "artifactName": "Starball-Lab-Setup-${version}.${ext}",
    "directories": {
      "output": "dist"
    },
    "asar": true,
    "files": [
      "widget/**/*",
      "*.mjs",
      "package.json",
      "!widget/make-icon.mjs",
      "!morning.mjs",
      "!cli.mjs",
      "!dryrun.mjs"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "widget/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Starball Lab"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "widget/icon.png",
      "category": "public.app-category.sports"
    },
    "dmg": {
      "artifactName": "Starball-Lab-${version}-${arch}.${ext}"
    }
  }
}
